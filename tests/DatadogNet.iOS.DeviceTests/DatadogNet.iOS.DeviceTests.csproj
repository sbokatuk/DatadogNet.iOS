<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Which of the packages' target frameworks to exercise. Overriding TargetFramework directly on
      the command line breaks restore, so it goes through a property of our own.
    -->
    <DatadogDeviceTargetFramework Condition=" '$(DatadogDeviceTargetFramework)' == '' ">net9.0-ios18.0</DatadogDeviceTargetFramework>
    <TargetFramework>$(DatadogDeviceTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>

    <ApplicationId>com.sbokatuk.datadognet.devicetests</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>12.2</SupportedOSPlatformVersion>

    <!--
      The smoke tests report through stdout, which the runner script streams back with
      `simctl launch` in console-pty mode. Quietening the Mono logger keeps that stream to the
      test output rather than runtime chatter.
    -->
    <MtouchExtraArgs>--setenv=MONO_LOG_LEVEL=error</MtouchExtraArgs>
  </PropertyGroup>

  <!--
    The e2e deliberately consumes the packed NuGets from ./artifacts rather than ProjectReferences,
    so it exercises the artifacts that actually get published - including their inter-package
    dependencies, which is the part a ProjectReference would prove nothing about. See NuGet.config
    for the local feed.

    These five references reach all eleven native frameworks. DatadogNet.Objc.iOS is the
    compatibility meta-package, referenced here rather than the modules it covers so that the
    meta-package itself is exercised: it pulls Core, RUM, Logs, Trace and SessionReplay (and
    Internal and OpenTelemetryApi through them). CrashReporting, WebViewTracking, Flags and
    Profiling are separate opt-ins. If that stops being true, the "every framework is linked" check
    fails rather than silently testing less.
  -->
  <PropertyGroup>
    <DatadogPackageVersion Condition=" '$(DatadogPackageVersion)' == '' ">$(VersionPrefix)</DatadogPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DatadogNet.Objc.iOS" Version="$(DatadogPackageVersion)" />
    <PackageReference Include="DatadogNet.CrashReporting.iOS" Version="$(DatadogPackageVersion)" />
    <PackageReference Include="DatadogNet.WebViewTracking.iOS" Version="$(DatadogPackageVersion)" />
    <PackageReference Include="DatadogNet.Flags.iOS" Version="$(DatadogPackageVersion)" />
    <PackageReference Include="DatadogNet.Profiling.iOS" Version="$(DatadogPackageVersion)" />
  </ItemGroup>

</Project>
