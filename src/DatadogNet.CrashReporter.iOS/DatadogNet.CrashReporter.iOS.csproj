<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <DatadogFramework>CrashReporter</DatadogFramework>
    <DatadogPackageName>CrashReporter</DatadogPackageName>
    <Description>.NET for iOS / .NET MAUI bindings for PLCrashReporter, the crash-capture engine Datadog crash reporting is built on, as shipped inside the Datadog iOS SDK $(DatadogNativeVersion) release. Reference DatadogNet.CrashReporting.iOS to enable Datadog crash reporting; this package is its engine and is pulled in automatically.</Description>
    <PackageTags>plcrashreporter;crash-reporting</PackageTags>
  </PropertyGroup>

  <Import Project="../Datadog.Binding.props" />

  <!--
    No dependencies: PLCrashReporter knows nothing about Datadog. It is versioned in lock-step
    with the Datadog packages rather than with PLCrashReporter upstream (which is at 1.11.x),
    because it ships inside Datadog.xcframework.zip and is only ever consumed alongside it - the
    previous CrashReporter.iOS package used the 1.11.2.x numbering, which made it impossible to
    tell which Datadog release a given build belonged to.
  -->

</Project>
