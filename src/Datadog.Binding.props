<!--
  Everything the eleven binding projects have in common.

  Imported explicitly by each .csproj rather than picked up as a Directory.Build.props, because it
  reads properties the project sets - DatadogFramework and DatadogPackageName - and
  Directory.Build.props is imported before the project body, so it would see neither. That leaves
  each binding project as roughly a dozen lines: its identity, its description, and its
  dependencies.
-->
<Project>

  <PropertyGroup>
    <!--
      Each .NET SDK's iOS workload supports the current target framework and the previous one: the
      .NET 9 band builds net8.0-ios + net9.0-ios, the .NET 10 band builds net9.0-ios +
      net10.0-ios. No single SDK can build all three, so BuildNugets.sh packs twice and merges the
      results - see build/merge-packages.py. DatadogSdkBand selects which pass this build is.

      The platform version is pinned rather than left to the workload's default, because it ends
      up in the lib/<tfm>/ folder name inside the package. An unpinned net8.0-ios silently becomes
      whatever the installed workload currently defaults to, so a workload update would change the
      packages' advertised target frameworks without a single source edit - and, worse, would do
      it to only whichever of the two passes was run on the updated machine.
    -->
    <DatadogSdkBand Condition=" '$(DatadogSdkBand)' == '' ">net9</DatadogSdkBand>
    <TargetFrameworks Condition=" '$(DatadogSdkBand)' == 'net9' ">net8.0-ios18.0;net9.0-ios18.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$(DatadogSdkBand)' == 'net10' ">net10.0-ios26.0</TargetFrameworks>
    <!--
      net8.0-ios is past end of support, which the SDK reports as an error. It ships deliberately:
      .NET 8 is still where a large share of MAUI apps are, and the previous packages targeted
      net7/net8, so dropping net8 would strand every existing consumer.
    -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>

    <!--
      iOS 12.2, not the 12.0 the previous repository used. The Datadog frameworks are Swift, and
      they rely on the OS-provided Swift runtime rather than embedding their own - which is only
      ABI-stable from 12.2. A package claiming 12.0 was claiming support for two OS versions on
      which its own dependency does not exist.
    -->
    <SupportedOSPlatformVersion>12.2</SupportedOSPlatformVersion>

    <IsBindingProject>true</IsBindingProject>
    <!--
      Ship the native payload as a single <Assembly>.resources.zip rather than a
      <Assembly>.resources directory. The default is 'auto', which compresses only when the
      xcframework contains symlinks. The directory form is supported by the consuming SDK, but it
      puts every framework file into the package at paths like
      lib/net8.0-ios18.0/<assembly>.resources/DatadogObjc.xcframework/ios-arm64_x86_64-simulator/
      DatadogObjc.framework/Headers/DatadogObjc-Swift.h, which trips NU5123 and can exceed the
      260-character limit on Windows once the global packages folder is prepended - breaking
      restore for anyone in a MAUI solution without long path support.
    -->
    <CompressBindingResourcePackage>true</CompressBindingResourcePackage>

    <!--
      The namespace is the bare framework name - DatadogCore, DatadogObjc, DatadogSessionReplay -
      because that is what Objective Sharpie emitted and what the previous packages exposed.
      Keeping it means upgrading from DatadogCore.iOS to DatadogNet.Core.iOS is a PackageReference
      edit and nothing else: no `using` directive and no call site changes.
    -->
    <RootNamespace>$(DatadogFramework)</RootNamespace>
    <AssemblyName>DatadogNet.$(DatadogPackageName).iOS</AssemblyName>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591: the generated binding has no XML doc comments.
      CS0108/CS0109: Swift protocol conformances reach C# as a protocol interface plus a class that
      redeclares the same members, so the generator legitimately emits members that hide - or that
      are marked `new` without hiding - an inherited one. DatadogURLSessionDelegate alone accounts
      for a dozen of these, and they are a property of how Objective Sharpie projects Swift, not
      something fixable in the binding definitions.
    -->
    <NoWarn>$(NoWarn);CS1591;CS0108;CS0109</NoWarn>

    <!--
      Trim and AOT analysis, permanently on. The Additions layer is ordinary managed code that
      could acquire a reflection dependency without anyone noticing; with the analyzers on, an
      unsafe pattern surfaces at build time. The generated tier analyses clean too - measured
      before this was enabled, not assumed.

      IsTrimmable is deliberately NOT set. It would opt these assemblies into consumer-side
      trimming under partial trim modes - a behaviour change for every app - and the device tests
      do not exercise trimmed builds. The iOS linker's Objective-C-aware steps already treat
      binding assemblies correctly without it.
    -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <!-- Packaging -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>DatadogNet.$(DatadogPackageName).iOS</PackageId>
    <Title>.NET for iOS bindings for the native $(DatadogFramework) framework.</Title>
    <PackageTags>$(PackageTags);datadog;observability;SDK;MAUI;iOS;dotnet-ios;Binding</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../build/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
    <!--
      Both licence texts the package is covered by: MIT for the binding code in this repository,
      Apache-2.0 for the native binaries built by Datadog. Packed into a folder so each file keeps
      its own name - naming the target explicitly would make NuGet treat the extensionless LICENSE
      as a directory.
    -->
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="licenses/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../licenses/Apache-2.0.txt" Pack="true" PackagePath="licenses/" Visible="false" />
  </ItemGroup>

  <!--
    The xcframeworks live in one directory at the repository root rather than one copy per project:
    they arrive as a single archive, several are 30 MB, and eleven private copies would be both
    slower to produce and easy to leave half-updated after a version bump.
  -->
  <PropertyGroup>
    <DatadogXcFramework>$(MSBuildThisFileDirectory)../libs/$(DatadogFramework).xcframework</DatadogXcFramework>
  </PropertyGroup>

  <Target Name="ValidateDatadogXcFramework" BeforeTargets="Build;Pack"
          Condition="!Exists('$(DatadogXcFramework)')">
    <Error Text="$(DatadogFramework).xcframework is missing. Run ./build/FetchXcFrameworks.sh first." />
  </Target>

  <Target Name="ValidateDatadogSdkBand" BeforeTargets="Build;Pack" Condition=" '$(TargetFrameworks)' == '' ">
    <Error Text="DatadogSdkBand must be 'net9' or 'net10', but was '$(DatadogSdkBand)'." />
  </Target>

  <ItemGroup>
    <!--
      ForceLoad and SmartLink=False are carried over from the previous bindings, which shipped
      this way for the whole 2.x line. They matter most for CrashReporter, which - alone among the
      eleven - is a static archive rather than a dynamic framework: its Objective-C categories are
      only reachable if the whole archive is loaded, and without ForceLoad the crash handler
      silently fails to install at runtime rather than failing to link.
    -->
    <NativeReference Include="$(DatadogXcFramework)">
      <Kind>Framework</Kind>
      <ForceLoad>True</ForceLoad>
      <SmartLink>False</SmartLink>
    </NativeReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      Every product module binds its own DD* surface here, since dd-sdk-ios 3.0 deleted the
      DatadogObjc umbrella framework and moved the DD* types into the module each belongs to.
      Only DatadogFlags, DatadogProfiling and OpenTelemetryApi have a near-empty ApiDefinitions.cs:
      upstream projects none of their Swift surface into Objective-C, so there is nothing to bind -
      each file says so. It is still required even then, because a binding project with no
      ObjcBindingApiDefinition does not build.
    -->
    <ObjcBindingApiDefinition Include="ApiDefinitions.cs" />
    <ObjcBindingCoreSource Include="StructsAndEnums.cs" Condition="Exists('$(MSBuildProjectDirectory)/StructsAndEnums.cs')" />
  </ItemGroup>

</Project>
