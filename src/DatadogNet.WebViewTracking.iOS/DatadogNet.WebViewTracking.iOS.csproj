<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <DatadogFramework>DatadogWebViewTracking</DatadogFramework>
    <DatadogPackageName>WebViewTracking</DatadogPackageName>
    <Description>.NET for iOS / .NET MAUI bindings for the native Datadog iOS SDK's DatadogWebViewTracking framework: bridges RUM and Logs events out of a WKWebView running the Datadog Browser SDK, so hybrid apps report one session across native and web. Built against dd-sdk-ios $(DatadogNativeVersion).</Description>
    <PackageTags>datadog-webview;webview;hybrid</PackageTags>
  </PropertyGroup>

  <Import Project="../Datadog.Binding.props" />

  <!--
    ProjectReference, not PackageReference: `dotnet pack` turns each one into a NuGet dependency on
    the referenced package at the same version, so the published graph is identical either way -
    but a PackageReference at $(Version) cannot restore until that version has been packed, which
    makes a clean clone unbuildable and forces every local build through the packing script in
    dependency order.
  -->
  <ItemGroup>
    <ProjectReference Include="../DatadogNet.Core.iOS/DatadogNet.Core.iOS.csproj" />
    <ProjectReference Include="../DatadogNet.Internal.iOS/DatadogNet.Internal.iOS.csproj" />
  </ItemGroup>

</Project>
